# ===== Blindspot env =====
# Salin ke `.env.local` dan sesuaikan. Jangan pernah commit secret asli.

# --- Backend (Go, port 8080) ---
# Port HTTP server Go (rewrite Next /api/* menuju 127.0.0.1:8080).
PORT="8080"

# Koneksi MySQL (XAMPP default: root tanpa password).
MYSQL_DSN="root:@tcp(127.0.0.1:3306)/blindspot?parseTime=true&charset=utf8mb4&collation=utf8mb4_unicode_ci"

# Secret HMAC sesi. Wajib SAMA persis antara Go dan Next.js.
# Jika kosong, Go menulis/membaca `.data/auth-secret` otomatis dan men-
# selaraskannya dengan `src/lib/auth/secret.ts` (storagePath = <cwd>/.data).
# Di produksi: generate 64 char acak dan set di env BOTH process.
AUTH_SECRET=""

# --- AI (asisten & analisis laporan) ---
GROQ_API_KEY=""

# Cookie Secure (true saat HTTPS/produksi).
COOKIE_SECURE="false"

# Allowlist origin browser untuk CORS. Kosong = default dev (localhost:3000/8080).
# Produksi: isi domain aslimu, mis. "https://blindspot.id". Pisah koma bila banyak.
APP_ORIGINS=""

# Hormati X-Forwarded-For / X-Real-IP dari reverse proxy (Caddy/Nginx).
# NYALAKAN hanya jika backend ada di belakang proxy; jangan di localhost.
TRUST_PROXY_HEADERS="false"

# --- Pool MySQL (opsional; default aman) ---
DB_MAX_OPEN="20"
DB_MAX_IDLE="5"
DB_CONN_LIFETIME_SECONDS="300"

# Variabel legacy Prisma — tidak lagi dipakai (layer data lama sudah hapus).
DATABASE_URL=""

# --- Web/Next (runtime server) ---
# Alamat backend untuk rewrite /api/*. Localhost untuk `next dev`/`next start`.
# Di docker compose set "http://backend:8080".
INTERNAL_API_URL="http://127.0.0.1:8080"

# Alamat backend untuk fetch server-side (komponen komunitas).
BACKEND_URL="http://127.0.0.1:8080"