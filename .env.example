# Database PostgreSQL — wajib diisi untuk fitur berbasis data nyata.
# Jika kosong, aplikasi berjalan dengan data DEMO/MOCK yang diberi label jelas (RULE 1).
DATABASE_URL="postgresql://user:password@localhost:5432/blindspot?schema=public"

# Wajib diubah di deployment nyata. Jangan pernah commit secret asli.
AUTH_SECRET="ganti-ini-di-produksi"
