generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProfileType {
  VISUAL_NAVIGATION
  WHEELCHAIR_MOBILITY
}

enum UserRole {
  USER
  ADMIN
}

enum EntranceType {
  MAIN
  ALTERNATE
  SERVICE
}

enum FeatureType {
  RAMP
  ELEVATOR
  STAIRS
  AUTOMATIC_DOOR
  NARROW_DOOR
  HIGH_THRESHOLD
  BRAILLE
  TACTILE
  PEDESTRIAN_LIGHT
}

enum ReportStatus {
  PENDING
  VERIFIED
  ACTIVE
  OUTDATED
  RESOLVED
  REJECTED
}

enum VerificationStatus {
  VERIFIED
  COMMUNITY_REPORTED
  UNKNOWN
}

model User {
  id                   String                 @id @default(cuid())
  email                String                 @unique
  displayName          String
  passwordHash         String
  role                 UserRole               @default(USER)
  avatarUrl            String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  accessibilityProfile AccessibilityProfile?
  savedPlaces          SavedPlace[]
  reports              AccessibilityReport[]
  verifications        ReportVerification[]
}

model AccessibilityProfile {
  id                String      @id @default(cuid())
  userId            String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              ProfileType
  mobilityDetail    String?
  preferredVoiceRate Float?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model Place {
  id          String   @id @default(cuid())
  name        String
  address     String?
  city        String
  latitude    Float
  longitude   Float
  category    String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  entrances   Entrance[]
  features    AccessibilityFeature[]
  reports     AccessibilityReport[]
  score       AccessibilityScore?
  savedBy     SavedPlace[]
}

model Entrance {
  id        String      @id @default(cuid())
  placeId   String
  place     Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  name      String
  type      EntranceType
  stepCount Int         @default(0)
  hasRamp   Boolean     @default(false)
  widthCm   Int?
  lat       Float?
  long      Float?
  notes     String?
}

model AccessibilityFeature {
  id      String      @id @default(cuid())
  placeId String
  place   Place       @relation(fields: [placeId], references: [id], onDelete: Cascade)
  type    FeatureType
  present Boolean     @default(true)
  notes   String?
}

model AccessibilityReport {
  id               String             @id @default(cuid())
  placeId          String?
  place            Place?             @relation(fields: [placeId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?              @relation(fields: [authorId], references: [id])
  category         String             @default("OTHER")
  title            String
  body             String
  severity         String             @default("MEDIUM")
  affectedProfiles String[]           @default([])
  aiGenerated      Boolean            @default(false)
  latitude         Float?
  longitude        Float?
status           ReportStatus       @default(PENDING)
   moderationNotes  String?
   createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  media            ReportMedia[]
  verifications    ReportVerification[]
}

model ReportMedia {
  id       String             @id @default(cuid())
  reportId String
  report   AccessibilityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind     String
  url      String
  caption  String?
}

model ReportVerification {
  id               String             @id @default(cuid())
  reportId         String
  report           AccessibilityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?              @relation(fields: [userId], references: [id])
  verificationType String
  comment          String?
  yesVotes         Int                @default(0)
  noVotes          Int                @default(0)
  result           VerificationStatus @default(UNKNOWN)
  verifiedAt       DateTime?          @default(now())
}

model AccessibilityScore {
  id           String   @id @default(cuid())
  placeId      String   @unique
  place        Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  visualValue  Float
  mobilityValue Float
  rating       Float
  updatedAt    DateTime @updatedAt
}

model SavedPlace {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, placeId])
}