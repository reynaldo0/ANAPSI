# ============================================================
# Blindspot — produksi (VPS). Salin ke `deploy/.env`, lalu isi.
#   cd deploy && cp .env.example .env && $EDITOR .env
# KOMENTAR TIDAK BOLEH ADA di baris nilai (docker compose).
# ============================================================

# Wajib: dipakai backend (penandatangan sesi) DAN web (verifikasi proxy).
# Buat sekali & simpan baik-baik:  openssl rand -hex 32
AUTH_SECRET=ubah-ini-pakai-openssl-rand-hex-32-panjang

# Kredensial MySQL untuk container `db`. Password jangan memakai karakter
# khusus (!@#, dll) karena bisa bertabrakan dengan format DSN Go.
MYSQL_ROOT_PASSWORD=ganti-root-password
MYSQL_PASSWORD=ganti-password-biasa

# Origin browser yang boleh memakai API (CORS). Wajib = domain produksimu.
# Bisa lebih dari satu, pisahkan koma: https://blindspot.id,https://www.blindspot.id
APP_ORIGINS=https://blindspot.example.com

# Opsional: API key Groq untuk fitur AI. Kosongkan jika tak dipakai.
GROQ_API_KEY=

# Tuning pool MySQL (optional; default aman untuk VPS kecil).
# DB_MAX_OPEN=40
# DB_MAX_IDLE=10
# DB_CONN_LIFETIME_SECONDS=300

# Catatan: PORT backend dikunci 8080 di dalam compose; jangan ubah di sini.