# Ganti anapsi.example.com dengan domain asli milikmu.
# Jika cuma memakai IP (tanpa domain), Caddy tidak bisa menerbitkan sertifikat
# gratis; arahkan domain/DNS dulu, atau gunakan HTTPS dengan self-signed.

anapsi.example.com {
	encode zstd gzip

	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}